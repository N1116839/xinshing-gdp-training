rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userPath(uid) {
      return /databases/$(database)/documents/gdpUsers/$(uid);
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // §38／§48 超級管理員（文管・開發者）：hardcode email，解超管啟動死結。
    // 與 HTML 的 SUPER_ADMIN_EMAILS 必須一致。
    function isSuperAdminEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['tom741285@gmail.com'];
    }
    // §38.6 超管在後台 gdpConfig/access 設定的管理者 email（取得管理者權限）。與 HTML configuredAdminEmails 同源。
    function isConfiguredAdminEmail() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/gdpConfig/access)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/gdpConfig/access).data.get('adminEmails', []);
    }
    function isAdmin() {
      return isSuperAdminEmail() || isConfiguredAdminEmail() || (
        signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.status == 'active'
        && get(userPath(request.auth.uid)).data.roles is list
        // 2026-06-17: new approvals use gdp_admin/doc_superadmin only.
        // Legacy role ids remain temporarily so existing admins do not lose access before profiles are normalized.
        && get(userPath(request.auth.uid)).data.roles.hasAny(['gdp_admin','doc_superadmin','rp_admin','qa_admin','sales_lead','warehouse_lead'])
      );
    }
    match /gdpUsers/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid','email','empId','name','department','title','roles','status','createdAt','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.empId is string
        && request.resource.data.empId.size() <= 30
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50
        && request.resource.data.department is string
        && request.resource.data.department.size() <= 50
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 50
        && request.resource.data.roles is list
        && request.resource.data.roles.size() == 1
        && request.resource.data.roles[0] == 'staff'
        && request.resource.data.status == 'pending'
        || (isSelf(uid) && isSuperAdminEmail())
        || (isSelf(uid) && isConfiguredAdminEmail());
      allow update: if isAdmin()
        || (isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','department','title','consentVersion','consentedAt','updatedAt']));
    }
    // §38.6 管理者 email 名單：登入者可讀（前端建通知收件人＋判權限），只有超管可寫。
    match /gdpConfig/{cfg} {
      allow read: if signedIn();
      allow write: if isSuperAdminEmail()
        && request.resource.data.keys().hasOnly(['adminEmails','updatedAt'])
        && request.resource.data.adminEmails is list
        && request.resource.data.adminEmails.size() <= 50;
    }
    // 進站前使用同意書稽核（append-only）：本人可建立自己的同意/不同意紀錄，管理者可讀，不可改不可刪。
    match /gdpConsentLogs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.decision in ['agree','disagree']
        && request.resource.data.version is string
        && request.resource.data.empId is string;
      allow update, delete: if false;
    }
    match /gdpUserApplications/{appId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','email','empId','name','department','title','requestedRoles','status','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.requestedRoles is list
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
    }
    match /gdpAuditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    match /gdpRoleChangeLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    match /gdpTrainingQa/{sectionId}/items/{itemId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name','question','sectionId','createdAt']) && request.resource.data.name is string && request.resource.data.name.size() <= 50 && request.resource.data.question is string && request.resource.data.question.size() <= 1000;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies']);
    }
    match /gdpTrainingCalendarStatus/{sectionId}/items/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['sectionId','itemId','statusYear','itemIndex','status','updatedAt'])
        && request.resource.data.keys().hasAll(['sectionId','itemId','statusYear','itemIndex','status','updatedAt'])
        && request.resource.data.sectionId == sectionId
        && request.resource.data.statusYear is int
        && docId == string(request.resource.data.statusYear) + '__' + request.resource.data.itemId
        && request.resource.data.itemIndex is int
        && request.resource.data.status in ['done','pending'];
    }
    match /gdpKnowledgeBase/{docId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['keywords','topic','international','taiwan','xinshing'])
        && request.resource.data.topic is string
        && request.resource.data.topic.size() <= 100
        && request.resource.data.keywords is list;
    }
    match /gdpUsageEvents/{eventId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['eventType','visitorId','displayName','sectionId','targetId','targetLabel','question','status','quarter','createdAt'])
        && request.resource.data.keys().hasAll(['eventType','visitorId','displayName','sectionId','quarter','createdAt'])
        && request.resource.data.eventType in ['page_view','question','reply','calendar_status','kb_search','doc_open']
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() <= 80
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 50;
    }
    match /gdpUserStats/{visitorId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['visitorId','displayName','eventCount','questionCount','replyCount','calendarDoneCount','queryCount','docOpenCount','updatedAt'])
        && request.resource.data.visitorId == visitorId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 50;
    }
    match /gdpQuestionStats/{questionId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['question','count','lastAskedAt'])
        && request.resource.data.question is string
        && request.resource.data.question.size() <= 100;
    }
    match /gdpRegulationReview/{quarterId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['quarter','status','scope','note','updatedAt'])
        && request.resource.data.quarter == quarterId
        && request.resource.data.status in ['待更新','更新中','已更新']
        && request.resource.data.scope is list;
    }
    match /gdpDocStats/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['docId','title','openCount','lastOpenedAt'])
        && request.resource.data.docId == docId
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100;
    }
    match /gdpGovDeficiencySources/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['sourceId','title','type','year','url','localFile','description','createdAt'])
        && request.resource.data.keys().hasAll(['sourceId','title','type','year','url'])
        && request.resource.data.sourceId == docId
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.type in ['TFDA','PICS']
        && request.resource.data.year is int;
    }
    match /gdpGovDeficiencyItems/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['itemId','text','source','year','type','sectionId','sectionTitle','sourceId','evidenceToPrepare','auditQuestion','answerDirection','createdAt'])
        && request.resource.data.keys().hasAll(['itemId','text','source','year','type','sectionId','sourceId'])
        && request.resource.data.itemId == docId
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && request.resource.data.source in ['TFDA','PICS','EU']
        && request.resource.data.year is int
        && request.resource.data.sectionId is string
        && request.resource.data.sourceId is string;
    }
  }
}
